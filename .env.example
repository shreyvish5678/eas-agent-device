# Required for the default live model evaluation.
GEMINI_API_KEY=

# Optional for Claude model configs.
ANTHROPIC_API_KEY=

# Optional model/evaluation controls.
QA_MODEL_CONFIGS=gemini-2.5-flash,gemini-2.5-flash-lite
QA_DRIVER=source
QA_TEST_CASES=

# Optional real device/app run controls for agent-device mode.
QA_PLATFORM=android
APPLICATION_ID=com.aitranslator
APP_PATH=/absolute/path/to/AITranslator.apk

# Optional legacy EAS agent runner controls.
AI_GATEWAY_API_KEY=
QA_MODEL=openai/gpt-5.4-mini
